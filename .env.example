# MongoDB bağlantı adresi (Render'da gerçek Atlas URI'ını buraya koy)
MONGO_URI=mongodb://127.0.0.1:27017/gastromind

# OpenAI API anahtarı
OPENAI_API_KEY=sk-...

# Admin/superadmin girişi artık Admin koleksiyonunda (bcrypt hash), .env'de değil.
# Rastgele, uzun ve tahmin edilemez bir değer kullan (örn: openssl rand -hex 32)
ADMIN_JWT_SECRET=change-this-before-deploy

# Cloudinary (menü fotoğrafları) — dashboard.cloudinary.com'dan al
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PORT=5000
